{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/runtime-config.json", "/manifest.webmanifest", "/*.{css,js,svg,png,ico}"]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "no-referrer",
    "Permissions-Policy": "camera=(), geolocation=(), microphone=()"
  }
}
